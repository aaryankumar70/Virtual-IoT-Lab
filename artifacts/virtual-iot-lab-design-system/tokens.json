{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Virtual IoT Lab engineering-tool design tokens extracted from the existing application. Edit this file only; generated theme files are derived from it.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#edf2f1" },
      "foreground": { "$value": "#172830" },
      "border": { "$value": "#c7d3d5" },
      "input": { "$value": "#c5d2d2" },
      "ring": { "$value": "#3b9793" },
      "card": { "$value": "#f4f7f7" },
      "cardForeground": { "$value": "#24464c" },
      "popover": { "$value": "#f8fbfa" },
      "popoverForeground": { "$value": "#345257" },
      "primary": { "$value": "#0d7777", "$description": "Teal signal color for primary actions, active controls, pins, and selected states." },
      "primaryForeground": { "$value": "#f5fbfa" },
      "secondary": { "$value": "#e4eeee" },
      "secondaryForeground": { "$value": "#30464c" },
      "muted": { "$value": "#e9f3f1" },
      "mutedForeground": { "$value": "#748689" },
      "accent": { "$value": "#e3a62f", "$description": "Amber hardware accent for run state, signal emphasis, and instrument details." },
      "accentForeground": { "$value": "#172830" },
      "destructive": { "$value": "#7d3832" },
      "destructiveForeground": { "$value": "#ffe2d8" },
      "chart1": { "$value": "#168988" },
      "chart2": { "$value": "#e3a62f" },
      "chart3": { "$value": "#c06b58" },
      "chart4": { "$value": "#50ce9c" },
      "chart5": { "$value": "#7048a2" },
      "sidebar": { "$value": "#f4f7f7" },
      "sidebarForeground": { "$value": "#30464c" },
      "sidebarBorder": { "$value": "#c7d3d5" },
      "sidebarPrimary": { "$value": "#0d7777" },
      "sidebarPrimaryForeground": { "$value": "#f5fbfa" },
      "sidebarAccent": { "$value": "#e4eeee" },
      "sidebarAccentForeground": { "$value": "#1a6566" },
      "sidebarRing": { "$value": "#3b9793" }
    },
    "dark": {
      "background": { "$value": "#172830" },
      "foreground": { "$value": "#d6e6e7" },
      "border": { "$value": "#38545a" },
      "input": { "$value": "#55767b" },
      "ring": { "$value": "#3b9793" },
      "card": { "$value": "#213940" },
      "cardForeground": { "$value": "#eef8f6" },
      "popover": { "$value": "#1c2d33" },
      "popoverForeground": { "$value": "#d3e8e1" },
      "primary": { "$value": "#168f8a" },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#2f4b50" },
      "secondaryForeground": { "$value": "#c7d8d9" },
      "muted": { "$value": "#26444a" },
      "mutedForeground": { "$value": "#92abad" },
      "accent": { "$value": "#e3a62f" },
      "accentForeground": { "$value": "#172830" },
      "destructive": { "$value": "#a95249" },
      "destructiveForeground": { "$value": "#ffe2d8" },
      "chart1": { "$value": "#50ce9c" },
      "chart2": { "$value": "#e3a62f" },
      "chart3": { "$value": "#ee9183" },
      "chart4": { "$value": "#9bcfbe" },
      "chart5": { "$value": "#b18bdb" },
      "sidebar": { "$value": "#1c2d33" },
      "sidebarForeground": { "$value": "#c7d8d9" },
      "sidebarBorder": { "$value": "#2e4a50" },
      "sidebarPrimary": { "$value": "#168f8a" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#2a4850" },
      "sidebarAccentForeground": { "$value": "#d7e7e2" },
      "sidebarRing": { "$value": "#3b9793" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["Outfit", "sans-serif"], "$description": "Humanist UI face used for readable labels, headings, and controls." },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["DM Mono", "monospace"], "$description": "Technical face used for coordinates, code, states, and serial output." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.3125rem", "$description": "Compact 5px base radius from the lab interface." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel base rhythm; 24px is the workspace grid unit." }
  }
}